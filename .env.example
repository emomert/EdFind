# EdFind environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ─── Supabase ───────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API.
#
# Supabase recently renamed their keys. The mapping:
#   - Publishable Key (sb_publishable_...)  →  NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - Secret Key      (sb_secret_...)       →  SUPABASE_SERVICE_ROLE_KEY
# (Older projects may still show "anon" / "service_role" — those work too.)
#
# - URL and the publishable/anon key are safe to ship to the browser
#   (they're rate-limited and protected by RLS policies).
# - Secret/service-role key BYPASSES RLS — server-side only. Never put it in
#   a NEXT_PUBLIC_* variable or import it from a Client Component.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string used by scripts/db-migrate.mjs to apply
# schema migrations and seed without dashboard copy-paste. Get it from:
#   Supabase dashboard → Project Settings → Database → Connection string →
#   URI mode (direct or session pooler — NOT transaction pooler, port 6543,
#   because transaction-mode pooling rejects DDL).
# Format: postgresql://postgres:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
# This is the *database* password, not any of the API keys.
SUPABASE_DB_URL=

# ─── AI providers (Phase 4+) ────────────────────────────────────────────────
# DeepSeek V4 Flash is the only wired provider. The lib/ai/ wrapper is
# OpenAI-compatible, so OPENAI_API_KEY is reserved for a future backup, but no
# OpenAI fallback exists in code today. Both keys are server-only — no
# NEXT_PUBLIC_ prefix.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional AI controls (read by lib/ai/client.ts):
#   AI_DISABLED=true   — kill switch; callDeepSeek throws AiDisabledError before
#                        any network call. Default off (unset / anything else).
#   AI_TIMEOUT_MS      — per-call AbortController timeout in milliseconds.
#                        Default 25000.
AI_DISABLED=
AI_TIMEOUT_MS=

# ─── Transactional email (university verification) ─────────────────────────
# Resend (resend.com) — see docs/decisions/0004-resend-transactional-email.md.
# Server-only. When RESEND_API_KEY is unset, verification emails are not sent;
# the UI shows the confirmation link directly (dev fallback).
# EMAIL_FROM must be a sender on a Resend-verified domain; the default
# onboarding@resend.dev only delivers to the Resend account owner's address.

RESEND_API_KEY=
EMAIL_FROM="EdFind <onboarding@resend.dev>"

# Optional canonical origin for emailed confirmation links (no trailing
# slash), e.g. https://ed-find.vercel.app. On Vercel this is inferred from
# VERCEL_PROJECT_PRODUCTION_URL when unset; set it explicitly for custom
# domains. Locally it falls back to the request origin.
NEXT_PUBLIC_SITE_URL=

# ─── Feature flags (Phase 9.3+) ─────────────────────────────────────────────
# Set to "false" to hide every entry point for the application tracker
# (header link, /applications route). Save buttons keep working — saving a
# program creates an applications row at status 'interested'. The database
# table stays — see supabase/rollbacks/20260511130000_drop_applications.sql
# for the full removal recipe. Default: on.
NEXT_PUBLIC_ENABLE_APPLICATIONS=true

# Set to "false" to hide the community / Verified Student Insights pages
# (/community route + header nav link). Read by lib/feature-flags.ts. The
# data is mock-only for now; subscription state is a cookie dev toggle until
# Stripe is wired. Default: on.
NEXT_PUBLIC_ENABLE_COMMUNITY=true

# Set to "false" to hide the housing & cost-of-living sections on university and
# program detail pages. Read by lib/feature-flags.ts. Data lives in the
# housing_cities / housing_universities tables (published rows only). Default: on.
NEXT_PUBLIC_ENABLE_HOUSING=true
