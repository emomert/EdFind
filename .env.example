# EdFind environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ─── Supabase ───────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API.
#
# Supabase recently renamed their keys. The mapping:
#   - Publishable Key (sb_publishable_...)  →  NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - Secret Key      (sb_secret_...)       →  SUPABASE_SERVICE_ROLE_KEY
# (Older projects may still show "anon" / "service_role" — those work too.)
#
# - URL and the publishable/anon key are safe to ship to the browser
#   (they're rate-limited and protected by RLS policies).
# - Secret/service-role key BYPASSES RLS — server-side only. Never put it in
#   a NEXT_PUBLIC_* variable or import it from a Client Component.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string used by scripts/db-migrate.mjs to apply
# schema migrations and seed without dashboard copy-paste. Get it from:
#   Supabase dashboard → Project Settings → Database → Connection string →
#   URI mode (direct or session pooler — NOT transaction pooler, port 6543,
#   because transaction-mode pooling rejects DDL).
# Format: postgresql://postgres:<DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
# This is the *database* password, not any of the API keys.
SUPABASE_DB_URL=

# ─── AI providers (Phase 4+) ────────────────────────────────────────────────
# DeepSeek is the default; OpenAI is the backup.
# Both are server-only — no NEXT_PUBLIC_ prefix.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ─── Feature flags (Phase 9.3+) ─────────────────────────────────────────────
# Set to "false" to hide every entry point for the application tracker
# (header link, "Track this application" button, /applications route). The
# database table stays — see supabase/migrations/20260511130000_drop_applications.sql
# for the full removal recipe. Default: on.
NEXT_PUBLIC_ENABLE_APPLICATIONS=true
